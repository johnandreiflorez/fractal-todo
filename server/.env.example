# Puerto del servidor
PORT=4000

# Conexión a PostgreSQL (docker-compose)
DATABASE_URL=postgres://todo:todo123@localhost:5432/todo_list

# Secreto para firmar los JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=cambia_este_secreto_por_uno_generado_aleatoriamente_de_al_menos_32_caracteres

# Expiración del access token (formato de ms/jsonwebtoken)
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (frontend en dev)
CORS_ORIGIN=http://localhost:5173